<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		<title>{% block title %}Portfolio{% endblock %} — Damien Chauveau</title>

		<meta name="description" content="{% block meta_description %}Portfolio de Damien Chauveau, développeur fullstack PHP Symfony / Angular à Bordeaux. API REST, interfaces Angular et applications métier déployées en production.{% endblock %}">
		<meta name="author" content="Damien Chauveau">
		<meta name="theme-color" content="#0A0C10">
		<link rel="canonical" href="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">

		<meta property="og:title" content="{% block og_title %}Damien Chauveau — Développeur Fullstack PHP Symfony / Angular{% endblock %}">
		<meta property="og:description" content="{% block og_description %}API REST Symfony, interfaces Angular et applications métier déployées en production. Découvrez mes projets.{% endblock %}">
		<meta property="og:image" content="{{ absolute_url(asset('image/og-image.png')) }}?v=2">
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">
		<meta property="og:url" content="{{ app.request.uri }}">
		<meta property="og:type" content="website">
		<meta property="og:locale" content="fr_FR">

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
		<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
		<link href="/styles/style.css?v=2" rel="stylesheet">
		{% block stylesheets %}{% endblock %}
	</head>

	<body>
		{% set route = app.request.attributes.get('_route') %}
		<nav class="site-nav" aria-label="Navigation principale">
			<div class="wrap nav-inner">
				<a class="brand" href="{{ path('app_home') }}">Damien Chauveau<span class="dot">.</span></a>
				<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links">Menu</button>
				<div class="nav-links" id="nav-links">
					<a href="{{ path('app_portfolio') }}" class="{{ route == 'app_portfolio' ? 'active' }}">Projets</a>
					<a href="{{ path('app_services') }}" class="{{ route == 'app_services' ? 'active' }}">Services</a>
					<a href="{{ path('app_about') }}" class="{{ route == 'app_about' ? 'active' }}">À propos</a>
					<a href="{{ path('app_contact') }}" class="{{ route starts with 'app_contact' ? 'active' }}">Contact</a>
					<a class="avail" href="{{ path('app_contact') }}">Dispo · CDI &amp; missions</a>
				</div>
			</div>
		</nav>

		<main>
			{% block body %}{% endblock %}
		</main>

		{% set yearRef = 2025 %}
		{% set yearNow = 'now'|date('Y') %}
		<footer class="site-footer">
			<div class="wrap foot">
				<div class="copy">
					© {{ yearRef < yearNow ? yearRef ~ '–' ~ yearNow : yearRef }} Damien Chauveau ·
					<a href="{{ path('app_legal') }}">Mentions légales</a>
				</div>
				<div class="right">
					<a href="https://github.com/DamienCH33" target="_blank" rel="me noopener">GitHub</a>
					<a href="https://www.linkedin.com/in/chauveau-damien/" target="_blank" rel="me noopener">LinkedIn</a>
					<a href="{{ asset('files/cv-damien-chauveau.pdf') }}?v=3" target="_blank" rel="noopener">CV (PDF)</a>
					{% if is_granted('ROLE_ADMIN') %}
						<a class="admin-on" href="{{ path('admin_dashboard') }}" rel="nofollow">● Back-office</a>
						<a class="admin" href="{{ path('app_logout') }}" rel="nofollow">Déconnexion</a>
					{% else %}
						<a class="admin" href="{{ path('admin_dashboard') }}" title="Administration" rel="nofollow">admin</a>
					{% endif %}
				</div>
			</div>
		</footer>

		<script>
			(function () {
				var btn = document.querySelector('.nav-toggle');
				var links = document.getElementById('nav-links');
				if (!btn || !links) return;
				btn.addEventListener('click', function () {
					var open = links.classList.toggle('open');
					btn.setAttribute('aria-expanded', open ? 'true' : 'false');
					btn.textContent = open ? 'Fermer' : 'Menu';
				});
			})();
		</script>
		{% block javascripts %}{% endblock %}
	</body>
</html>
