{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
	<section class="section">
		<div class="wrap">
			<div class="login-box">
				<span class="mono accent" style="font-size:.85rem;display:block;margin-bottom:14px">// administration</span>
				<h1 class="mb-4" style="font-size:2rem;font-weight:700;letter-spacing:-.02em">Connexion</h1>

				<div class="panel">
					{% if error %}
						<div class="alert alert-danger">
							{{ error.messageKey|trans(error.messageData, 'security') }}
						</div>
					{% endif %}

					<form action="{{ path('app_login') }}" method="post">
						<label for="username" class="form-label">E-mail</label>
						<input type="email" id="username" name="_username" value="{{ last_username }}" required autocomplete="email" autofocus class="form-control">

						<label for="password" class="form-label mt-3">Mot de passe</label>
						<input type="password" id="password" name="_password" required autocomplete="current-password" class="form-control">

						<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

						<button class="btn-v2 mt-4" type="submit">Se connecter →</button>
					</form>
				</div>
			</div>
		</div>
	</section>
{% endblock %}
