{% extends 'admin/layout.html.twig' %}

{% block title %}Modifier un projet
{% endblock %}

{% block body %}
	<div class="container py-4">
		<div class="d-flex justify-content-between align-items-center mb-4">
			<h2>🧩 Modifier un projet</h2>
			<a href="{{ path('admin_projects') }}" class="btn btn-primary-custom">↩ Retour</a>
		</div>

		{{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
		<div class="card p-4 shadow-sm">
			<div class="row">
				<div class="col-md-6 mb-3">
					{{ form_label(form.title) }}
					{{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
					{{ form_errors(form.title) }}
				</div>

				<div class="col-md-6 mb-3">
					{{ form_label(form.description) }}
					{{ form_widget(form.description) }}
					{{ form_errors(form.description) }}
				</div>

				<div class="col-md-12 mb-3">
					{{ form_label(form.techStack) }}
					{{ form_widget(form.techStack, {'attr': {'class': 'form-control'}}) }}
					{{ form_errors(form.techStack) }}
				</div>

				<div class="col-md-6 mb-3">
					{{ form_label(form.imageFile) }}
					<div class="input-group">
						{{ form_widget(form.imageFile, {'attr': {'class': 'form-control', 'onchange': 'updateFileName(this)'}}) }}
						<span class="input-group-text" id="fileNameDisplay">Aucun fichier choisi</span>
					</div>
					{{ form_errors(form.imageFile) }}
				</div>

				<div class="col-md-6 mb-3">
					{{ form_label(form.logoFile) }}
					{% if project is defined and project.logo %}
						<div class="mb-2"><img src="{{ asset('image/projects/' ~ project.logo) }}" alt="Logo actuel" height="40" style="border-radius:8px;background:#fff;padding:4px"></div>
					{% endif %}
					{{ form_widget(form.logoFile, {'attr': {'class': 'form-control'}}) }}
					{{ form_help(form.logoFile) }}
					{{ form_errors(form.logoFile) }}
				</div>

				<div class="col-md-6 mb-3">
					{{ form_label(form.link) }}
					{{ form_widget(form.link) }}
					{{ form_errors(form.link) }}
				</div>

				<div class="col-md-6 mb-3">
					{{ form_label(form.createdAt) }}
					{{ form_widget(form.createdAt) }}
					{{ form_errors(form.createdAt) }}
				</div>
			</div>

			<hr class="my-4">
			<h4 class="mb-1">Étude de cas</h4>
			<p class="small-muted mb-3">Remplis au moins « Le besoin » pour que le projet ait sa page détaillée sur le site{% if project is defined and project.slug %} (<a href="{{ path('app_project_show', {slug: project.slug}) }}" target="_blank">/projets/{{ project.slug }}</a>){% endif %}.</p>
			<div class="row">
				<div class="col-12 mb-3">{{ form_row(form.context) }}</div>
				<div class="col-12 mb-3">{{ form_row(form.approach) }}</div>
				<div class="col-12 mb-3">{{ form_row(form.challenge) }}</div>
				<div class="col-12 mb-3">{{ form_row(form.outcome) }}</div>
				<div class="col-md-8 mb-3">
					{% if project is defined and project.gallery is not empty %}
						<div class="mb-2 d-flex gap-2 flex-wrap">
							{% for capture in project.gallery %}
								<img src="{{ asset('image/projects/' ~ capture) }}" alt="" height="60" style="border-radius:6px">
							{% endfor %}
						</div>
					{% endif %}
					{{ form_row(form.galleryFiles) }}
				</div>
				<div class="col-md-4 mb-3 d-flex align-items-end">
					<div class="form-check">
						{{ form_widget(form.clearGallery, {attr: {class: 'form-check-input'}}) }}
						{{ form_label(form.clearGallery, null, {label_attr: {class: 'form-check-label'}}) }}
					</div>
				</div>
			</div>

			<button type="submit" class="btn btn-primary-custom mt-3">
				💾 Enregistrer
			</button>
		</div>
		{{ form_end(form) }}
	</div>

	<script>
		function updateFileName(input) {
const fileName = input.files.length > 0 ? input.files[0].name : 'Aucun fichier choisi';
document.getElementById('fileNameDisplay').innerText = fileName;
}
	</script>
{% endblock %}
