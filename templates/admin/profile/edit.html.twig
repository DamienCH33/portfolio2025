{% extends 'admin/layout.html.twig' %}

{% block title %}Mon profil / titre & CV{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="m-0">🪪 Mon profil (titre, accroche & CV)</h2>
        <a href="{{ path('admin_dashboard') }}" class="btn btn-primary-custom">↩ Retour</a>
    </div>

    {{ form_start(form) }}
    <div class="card p-4 shadow-sm">
        <div class="row">
            <div class="col-md-6 mb-3">
                {{ form_label(form.title) }}
                {{ form_widget(form.title) }}
                {{ form_errors(form.title) }}
            </div>
            <div class="col-md-6 mb-3">
                {{ form_label(form.subtitle) }}
                {{ form_widget(form.subtitle) }}
                {{ form_errors(form.subtitle) }}
            </div>
            <div class="col-md-12 mb-3">
                {{ form_label(form.intro) }}
                {{ form_widget(form.intro) }}
                {{ form_errors(form.intro) }}
            </div>
            <div class="col-md-6 mb-3">
                {{ form_label(form.githubUrl) }}
                {{ form_widget(form.githubUrl) }}
                {{ form_errors(form.githubUrl) }}
            </div>
            <div class="col-md-6 mb-3">
                {{ form_label(form.linkedinUrl) }}
                {{ form_widget(form.linkedinUrl) }}
                {{ form_errors(form.linkedinUrl) }}
            </div>
            <div class="col-md-12 mb-3">
                {{ form_label(form.cvFileUpload) }}
                {{ form_widget(form.cvFileUpload) }}
                {{ form_errors(form.cvFileUpload) }}
                {% if profile.cvFile %}
                    <p class="mt-2 mb-0">
                        CV actuel :
                        <a href="{{ asset('files/cv/' ~ profile.cvFile) }}" target="_blank" rel="noopener noreferrer">
                            {{ profile.cvFile }}
                        </a>
                    </p>
                {% endif %}
            </div>
        </div>
        <button type="submit" class="btn btn-primary-custom mt-3">💾 Enregistrer</button>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}
