{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block meta_description %}Contacter Damien Chauveau, développeur fullstack Symfony / Angular à Bordeaux : poste, mission freelance ou site internet.{% endblock %}

{% block body %}
	<header class="page-head">
		<div class="wrap">
			<span class="kicker">// contact</span>
			<h1>Parlons de <span class="accent">votre projet.</span></h1>
		</div>
	</header>

	<section class="section tight" id="contact">
		<div class="wrap contact-grid">
			<div class="contact-side">
				<p>Un poste de développeur fullstack, une mission Symfony / Angular, ou un site pour votre commerce ou votre association : laissez-moi un message, je réponds rapidement.</p>
				<p>Dites-moi où vous en êtes et ce que vous cherchez, même en deux lignes.</p>
				<div class="links">
					<a class="link-arrow sec" href="https://www.linkedin.com/in/damien-chauveau-747892100/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
					<a class="link-arrow sec" href="https://github.com/DamienCH33" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
					<a class="link-arrow sec" href="{{ asset('files/cv-damien-chauveau.pdf') }}?v=3" target="_blank" rel="noopener noreferrer">CV (PDF) ↗</a>
				</div>
			</div>

			<div class="panel">
				{% for message in app.flashes('success') %}
					<div class="alert alert-success">{{ message }}</div>
				{% endfor %}
				{% for message in app.flashes('danger') %}
					<div class="alert alert-danger">{{ message }}</div>
				{% endfor %}

				{% include 'form_contact.html.twig' %}
			</div>
		</div>
	</section>
{% endblock %}
