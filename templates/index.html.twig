{% extends 'base.html.twig' %}

{% block title %}Développeur fullstack Symfony / Angular à Bordeaux{% endblock %}

{% block body %}
	{% set cv_url = profile and profile.cvFile ? asset('files/cv/' ~ profile.cvFile) : asset('files/cv-damien-chauveau.pdf') ~ '?v=3' %}

	{# HERO #}
	<header class="hero">
		<div class="wrap">
			<p class="intro">
				<span class="name">{{ profile.title|default('Damien Chauveau') }}</span>
				— {{ profile.subtitle|default('Développeur Fullstack PHP Symfony / Angular') }}, Bordeaux.
			</p>
			<h1>Je conçois des applications<br>qui <span class="accent">tiennent en production.</span><br><span class="line2">Pas des démos.</span></h1>
			<p class="lead-text">{{ profile.intro|default('Je conçois des API REST avec Symfony et les interfaces Angular qui les consomment, de la base de données au déploiement. Près de dix ans dans l\'assurance m\'ont appris à partir du besoin métier avant d\'écrire du code.') }}</p>
			<div class="hero-actions">
				<a class="link-arrow primary" href="#projets">Voir mes projets →</a>
				<a class="link-arrow sec" href="{{ cv_url }}" target="_blank" rel="noopener noreferrer">Télécharger mon CV</a>
				<a class="link-arrow sec" href="{{ path('app_contact') }}">Me contacter</a>
			</div>
			<div class="creds">
				<div><div class="k">Symfony · Angular</div><div class="v">de l'API REST à l'interface</div></div>
				<div><div class="k">En production</div><div class="v">sites et apps livrés, utilisés pour de vrai</div></div>
				<div><div class="k">RNCP niv. 6</div><div class="v">développeur d'application PHP / Symfony</div></div>
				<div><div class="k">9 ans</div><div class="v">métier assurance (Willis Towers Watson)</div></div>
			</div>
		</div>
	</header>

	{# PROJETS #}
	<section class="section" id="projets">
		<div class="wrap">
			<div class="shead"><span class="idx">01</span><h2>Projets sélectionnés</h2><span class="rule"></span></div>
			<div class="case-list">
				{% for project in projects %}
					{% include '_project_row.html.twig' with {project: project} only %}
				{% else %}
					<p class="muted">Les projets arrivent.</p>
				{% endfor %}
			</div>
			<div class="shead-after">
				<a class="link-arrow primary" href="{{ path('app_portfolio') }}">Tous les projets →</a>
			</div>
		</div>
	</section>

	{# DEUX FAÇONS DE TRAVAILLER #}
	<section class="section" id="services">
		<div class="wrap">
			<div class="shead"><span class="idx">02</span><h2>Travailler ensemble</h2><span class="rule"></span></div>
			<div class="dual">
				<div class="cell">
					<span class="tag">// entreprises &amp; recruteurs</span>
					<h3>Développement fullstack</h3>
					<p>API REST Symfony, front Angular, back-offices, reprise de code existant. En CDI (Bordeaux ou remote) ou en mission freelance. Mon passé dans l'assurance aide sur les domaines métier denses : insurtech, mutuelles, éditeurs.</p>
					<a href="{{ path('app_contact') }}">Parler d'un poste ou d'une mission →</a>
				</div>
				<div class="cell">
					<span class="tag">// commerçants &amp; associations</span>
					<h3>Sites &amp; suivi mensuel</h3>
					<p>Site internet, fiche et avis Google, maintenance. Des offres claires avec un suivi chaque mois, pour Bègles, Villenave-d'Ornon et Bordeaux sud. Vous gérez votre métier, je gère le web.</p>
					<a href="{{ path('app_services') }}">Voir les offres →</a>
				</div>
			</div>
		</div>
	</section>

	{# STACK — depuis le back-office (Compétences) #}
	{% set categories = {
		'Langage': 'Langages',
		'Framework': 'Frameworks',
		'Architecture': 'Architecture',
		'Base de données': 'Bases de données',
		'Outils /DevOps': 'DevOps & outils',
		'Qualité / Tests': 'Qualité & tests'
	} %}
	{% set rows = [] %}
	{% for key, label in categories %}
		{% set names = skills|filter(s => s.category == key)|map(s => s.name) %}
		{% if names is not empty %}
			{% set rows = rows|merge([{label: label, value: names|join(' · ')}]) %}
		{% endif %}
	{% endfor %}
	{% if rows is not empty %}
		<section class="section" id="stack">
			<div class="wrap">
				<div class="shead"><span class="idx">03</span><h2>Stack &amp; outils</h2><span class="rule"></span></div>
				{% set half = (rows|length / 2)|round(0, 'ceil') %}
				<div class="sk-grid">
					{% for column in rows|batch(half) %}
						<div>
							{% for row in column %}
								<div class="sk-row"><span class="lab">{{ row.label }}</span><span class="val">{{ row.value }}</span></div>
							{% endfor %}
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}

	{# CTA #}
	<section class="final" id="contact">
		<div class="wrap">
			<h2>Un projet, un poste,<br>une <span class="accent">idée à construire ?</span></h2>
			<p>Je réponds vite. Dites-moi où vous en êtes, on voit ensemble si je peux aider.</p>
			<div class="hero-actions">
				<a class="btn-v2" href="{{ path('app_contact') }}">M'écrire →</a>
				<a class="link-arrow sec" href="{{ cv_url }}" target="_blank" rel="noopener noreferrer">Télécharger mon CV</a>
			</div>
		</div>
	</section>
{% endblock %}
